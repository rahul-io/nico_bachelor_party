# Copy to .env.local for local development. All of these are optional locally:
# with nothing set, the app runs on in-memory mock data.
# On Vercel, pull the real values with: vercel env pull .env.local

# Postgres connection string. Added automatically by the Neon integration
# (Vercel > Storage > Create Database > Neon). Unset = mock data.
# After setting it, create the tables once with: npm run db:setup
DATABASE_URL=

# Vercel Blob read/write token. Added automatically when a Blob store is
# connected to the project. Unset = uploads stay in memory.
BLOB_READ_WRITE_TOKEN=

# The invite code guests type on the first screen. Server-side only. Set manually.
# Case and surrounding spaces are ignored. Changing it sends everyone back to the gate.
# Unset in dev = the code is "ahoy". Unset in production = nobody can get in.
INVITE_CODE=

# Password for the Admin tab. Server-side only. Set manually.
# Unset in dev = password is "admin". Unset in production = admin disabled.
ADMIN_PASSWORD=

# Random string that signs the gate, login and admin cookies. Set manually.
# REQUIRED in production: without it nobody can get in.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Share link of the Google Photos album, shown as a button on the Photos tab.
# Public (sent to the browser). Unset = button hidden.
NEXT_PUBLIC_GOOGLE_PHOTOS_ALBUM_URL=
